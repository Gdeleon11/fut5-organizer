# Browser / Public Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VITE_ENABLE_PUSH_TESTS=false

# AI Primario (NVIDIA, Cloudflare, etc)
VITE_PRIMARY_LLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
VITE_PRIMARY_LLM_KEY=nvapi-your-key-here
VITE_PRIMARY_LLM_MODEL=z-ai/glm-5.2

# Fallback: Groq (opcional)
VITE_GROQ_API_KEY=gsk-your-key-here

# Server-Side Only Secrets (Configurar únicamente en Vercel Dashboard / .env.local)
# CRON_SECRET=your-cron-secret
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:soporte@f5manager.lat
# ENABLE_PUSH_TEST_ENDPOINT=false
