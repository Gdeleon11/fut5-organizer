# Frontend public variables (safe to expose in browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ---------------------------------------------------------------------------
# NEVER place private API keys with VITE_ prefix!
# Configure these SERVER-ONLY variables in Vercel Project Settings (not here):
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   PRIMARY_LLM_URL
#   PRIMARY_LLM_KEY
#   PRIMARY_LLM_MODEL
#   GROQ_API_KEY
#   GROQ_MODEL
#   VAPID_PRIVATE_KEY
#   CRON_SECRET
# ---------------------------------------------------------------------------
